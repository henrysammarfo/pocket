# Pocket runs on NEAR testnet only. Copy to .env.local, or run `npm run setup` to fill it for you.
# Never commit real keys. .env.local is gitignored.

# Your testnet root account (all Pocket accounts are its sub accounts)
NEXT_PUBLIC_POCKET_ROOT=yourroot.testnet

# Server keys (ed25519:...). `npm run setup` writes these from ./.secrets and ~/.near-credentials
SPONSOR_PRIVATE_KEY=   # the root key: creates user accounts
RELAYER_PRIVATE_KEY=   # pays gas for NEP-366 meta transactions and execute_intents
MAKER_PRIVATE_KEY=     # signs the counter side of paper stock trades
FAUCET_PRIVATE_KEY=    # signs pUSD faucet transfers

# Optional: AI chat and voice. Any OpenAI compatible API works. Without a key, Chat uses Pocket's
# built in helper and the browser's own speech recognition, and says so.
# Easiest: a free Groq key from https://console.groq.com/keys (chat openai/gpt-oss-120b, voice whisper-large-v3).
GROQ_API_KEY=
# Alternative: NEAR AI Cloud (private TEE models) from https://cloud.near.ai (needs credit).
NEARAI_API_KEY=
# Pick one when both are set: groq or nearai. Default is groq when GROQ_API_KEY is set.
AI_PROVIDER=
# Advanced overrides for any other OpenAI compatible provider:
# AI_API_KEY=  AI_BASE_URL=  AI_MODEL=  AI_INPUT_USD_PER_M=  AI_OUTPUT_USD_PER_M=
# STT_API_KEY=  STT_BASE_URL=  STT_MODEL=
# Server wide caps that keep you inside a free tier, and the monthly free credits per user:
# AI_GLOBAL_PER_MIN=25  AI_GLOBAL_PER_DAY=900  VOICE_GLOBAL_PER_MIN=18  VOICE_GLOBAL_PER_DAY=1800  FREE_CREDITS_PER_MONTH=1000

# Optional: Neon Postgres for activity, daily limits and rate limits. Without it, an in memory store is used.
DATABASE_URL=

# Optional tuning
NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
QUOTE_SECRET=            # HMAC for trade quotes; defaults to a hash of the maker key
MAX_PRICE_AGE_SEC=900    # refuse to quote on a price older than this
COINGECKO_API_KEY=       # optional demo key for higher rate limits
