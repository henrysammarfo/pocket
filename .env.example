# Neon Postgres (Vercel Storage Marketplace → Neon)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=

# Privy (required — invisible wallet login + sponsored settle)
VITE_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=

# Otari (https://otari.ai). Service key: API keys > Create key > Advanced > Service key.
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_SERVICE_KEY=
# Key from the separate pocket-guard workspace (no guardrail mandate there).
OTARI_GUARD_KEY=
# Routing policy names configured in Otari.
OTARI_INTENT_MODEL=pocket-intent
OTARI_EXPLAIN_MODEL=pocket-explain
# Routing policy in the pocket-guard workspace (safeguard classifier).
OTARI_GUARD_MODEL=pocket-guard
# Public https origin of this deployment, so Otari can reach /api/mcp.
POCKET_PUBLIC_ORIGIN=
# Long random strings you generate (at least 32 characters); never reuse a provider key here.
POCKET_GUARD_TOKEN=
POCKET_MCP_SIGNING_SECRET=
# Voice input stays off on the Otari branch.
POCKET_VOICE_INPUT=off

# Monad testnet
MONAD_CHAIN_ID=10143
MONAD_NETWORK=testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

